# Core Django configuration
DJANGO_SECRET_KEY=replace-with-a-random-50-character-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=operationalinbox.com,www.operationalinbox.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://operationalinbox.com,https://www.operationalinbox.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
# Development defaults to SQLite; production uses postgresql:// through the guarded cutover task.
DJANGO_DATABASE_URL=sqlite:///db.sqlite3
DJANGO_EMAIL_BACKEND=ses
DEFAULT_FROM_EMAIL=Operational Inbox <notifications@operationalinbox.com>
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Product limits and routing
MAX_DOMAINS_PER_USER=20
DOMAIN_PROVISION_RATE_LIMIT=5
DOMAIN_PROVISION_RATE_WINDOW_SECONDS=3600
DOMAIN_CLAIM_TTL_HOURS=72
DOMAIN_DOWNGRADE_GRACE_DAYS=30
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600
VERIFICATION_RESEND_RATE_LIMIT=3
VERIFICATION_RESEND_RATE_WINDOW_SECONDS=3600
INBOUND_SERVICE_DOMAIN=inbound.operationalinbox.com
PUBLIC_BASE_URL=https://operationalinbox.com

# Agent plugin and OAuth 2.1 remote MCP
MCP_RESOURCE_URL=https://operationalinbox.com/mcp
MCP_DOCUMENTATION_URL=https://operationalinbox.com/mcp-docs/
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai,https://claude.com
OPERATIONAL_INBOX_OAUTH_SERVER_ENABLED=true
OAUTH_ISSUER=https://operationalinbox.com
OAUTH_ACCESS_TOKEN_EXPIRE_SECONDS=900
OAUTH_AUTHORIZATION_CODE_EXPIRE_SECONDS=60
OAUTH_REFRESH_TOKEN_EXPIRE_SECONDS=2592000
OAUTH_DCR_ENABLED=true
OAUTH_DCR_PER_IP_HOURLY_LIMIT=20
OAUTH_DCR_GLOBAL_HOURLY_LIMIT=200
OAUTH_DCR_MAX_REDIRECT_URIS=10
OAUTH_DCR_CLIENT_RETENTION_DAYS=30
# Set temporarily to the exact portal-issued value while verifying the domain.
OPENAI_APPS_CHALLENGE_TOKEN=

# AWS us-east-1 email data plane (dedicated least-privilege credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_INGRESS_BUCKET=
AWS_INGRESS_QUEUE_URL=
AWS_INBOUND_TOPIC_ARN=
AWS_DELIVERY_TOPIC_ARN=
AWS_SES_CONFIGURATION_SET=operational-inbox
AWS_SES_RECEIPT_RULE_SET=operational-inbox
AWS_SES_RECEIPT_RULE=operational-inbox-allowlist
AWS_SES_SYSTEM_IDENTITY=operationalinbox.com

# Agent-authored outbound safety limits. Daily limits use a rolling 24-hour
# window; monthly limits reset at 00:00 UTC on the first day of each month.
# Set a limit to 0 to disable that limit.
FREE_OUTBOUND_RATE_LIMIT_PER_MINUTE=2
FREE_OUTBOUND_DAILY_ACCOUNT_LIMIT=10
FREE_OUTBOUND_DAILY_DOMAIN_LIMIT=10
FREE_OUTBOUND_MONTHLY_ACCOUNT_LIMIT=30
OUTBOUND_RATE_LIMIT_PER_MINUTE=30
OUTBOUND_DAILY_ACCOUNT_LIMIT=500
OUTBOUND_DAILY_DOMAIN_LIMIT=200
OUTBOUND_MONTHLY_ACCOUNT_LIMIT=5000

# OpenAI Responses API. Leave empty to keep ingestion/search available without AI.
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=gpt-5.6-luna
OPENAI_REPORT_MODEL=gpt-5.6-terra

# Stripe Billing (amounts use the currency's minor unit; 499 = USD 4.99)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_UNIT_AMOUNT=499
STRIPE_PRO_COMPARE_AT_UNIT_AMOUNT=999
STRIPE_PRO_CURRENCY=usd

# Backup encryption (URL-safe base64 encoding of exactly 32 random bytes; separate from Django secret)
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=/var/backups/operationalinbox
