{
  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "content_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Content Hash",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "title": "Revision Id",
            "type": "string"
          }
        },
        "required": [
          "revision_id",
          "content_hash"
        ],
        "title": "ApprovalInput",
        "type": "object"
      },
      "ClassificationInput": {
        "properties": {
          "category": {
            "enum": [
              "ACTIONABLE",
              "INFORMATIONAL",
              "SUSPICIOUS",
              "UNCERTAIN"
            ],
            "title": "Category",
            "type": "string"
          },
          "recommended_action": {
            "default": "",
            "maxLength": 1200,
            "title": "Recommended Action",
            "type": "string"
          },
          "requires_reply": {
            "default": false,
            "title": "Requires Reply",
            "type": "boolean"
          },
          "summary": {
            "default": "",
            "maxLength": 1200,
            "title": "Summary",
            "type": "string"
          },
          "topic": {
            "default": "",
            "maxLength": 120,
            "title": "Topic",
            "type": "string"
          },
          "urgency": {
            "default": "NORMAL",
            "enum": [
              "LOW",
              "NORMAL",
              "HIGH",
              "CRITICAL"
            ],
            "title": "Urgency",
            "type": "string"
          }
        },
        "required": [
          "category"
        ],
        "title": "ClassificationInput",
        "type": "object"
      },
      "ConversationActionInput": {
        "properties": {
          "action": {
            "enum": [
              "star",
              "unstar",
              "archive",
              "trash",
              "restore"
            ],
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "ConversationActionInput",
        "type": "object"
      },
      "ConversationTagInput": {
        "properties": {
          "tag": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Tag",
            "type": "string"
          }
        },
        "required": [
          "tag"
        ],
        "title": "ConversationTagInput",
        "type": "object"
      },
      "DomainInput": {
        "properties": {
          "hostname": {
            "maxLength": 253,
            "minLength": 3,
            "title": "Hostname",
            "type": "string"
          },
          "setup_mode": {
            "enum": [
              "DIRECT_MX",
              "PROVIDER_FORWARD"
            ],
            "title": "Setup Mode",
            "type": "string"
          }
        },
        "required": [
          "hostname",
          "setup_mode"
        ],
        "title": "DomainInput",
        "type": "object"
      },
      "RevisionInput": {
        "properties": {
          "body_text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Body Text",
            "type": "string"
          },
          "subject": {
            "maxLength": 998,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "body_text"
        ],
        "title": "RevisionInput",
        "type": "object"
      },
      "RoutingTransitionInput": {
        "properties": {
          "target_mode": {
            "enum": [
              "DIRECT_MX",
              "PROVIDER_FORWARD"
            ],
            "title": "Target Mode",
            "type": "string"
          }
        },
        "required": [
          "target_mode"
        ],
        "title": "RoutingTransitionInput",
        "type": "object"
      },
      "TokenInput": {
        "properties": {
          "all_domains": {
            "default": false,
            "title": "All Domains",
            "type": "boolean"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "enum": [
                "read",
                "write",
                "manage_domains",
                "approve_send"
              ],
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "title": "TokenInput",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ScopedBearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "SessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
